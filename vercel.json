{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/capture.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/studio", "destination": "/index.html" },
    { "source": "/studio/:path*", "destination": "/index.html" }
  ]
}
